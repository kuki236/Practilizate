/// Puente oferta-carrera. Una oferta puede pertenecer a varias carreras.
table Carreras
	lineageTag: ddc391da-6f83-4982-be09-9f1c418be17a

	column offer_id
		dataType: string
		isHidden
		lineageTag: 095b1e95-af5d-4624-996d-27a96a9a3477
		summarizeBy: none
		sourceColumn: offer_id

	column career_id
		dataType: string
		isHidden
		lineageTag: 45287874-f940-4fe3-a919-d3fdc892ed89
		summarizeBy: none
		sourceColumn: career_id

	column career_name
		dataType: string
		lineageTag: 072c9c67-bf7b-4cdc-b623-08654615d22f
		summarizeBy: none
		sourceColumn: career_name

	partition Carreras = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\offer_careers.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"offer_id", type text}, {"career_id", type text}, {"career_name", type text}})
				in
				    Typed

