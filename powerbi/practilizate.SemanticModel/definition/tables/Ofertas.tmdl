	partition Ofertas = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dashboard_dataset.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"offer_id", type text}, {"title", type text}, {"company", type text}, {"company_normalized", type text}, {"location", type text}, {"district", type text}, {"department", type text}, {"modality", type text}, {"attendance", type text}, {"salary_text", type text}, {"salary_amount", type number}, {"salary_currency", type text}, {"published_at", type date}, {"deadline_at", type date}, {"status", type text}, {"career_count", Int64.Type}, {"careers", type text}, {"skill_count", Int64.Type}, {"skills", type text}, {"requirements_text", type text}, {"source_fetched_at", type text}, {"quality_score", type number}, {"days_to_deadline", Int64.Type}})
				in
				    Typed

