/// Una fila por oferta normalizada de practicas.pe.
table Ofertas
	lineageTag: 077e5c14-d274-49fe-885e-12b1efc79a25

	/// Cantidad de ofertas en el contexto actual.
	measure 'Total Ofertas' = COUNTROWS('Ofertas')
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: f16b3ff1-0f1c-4856-af11-3f4c9856dbd6

	/// Empresas distintas con al menos una oferta, excluyendo valores vacíos.
	measure Empresas =
			CALCULATE(
			    DISTINCTCOUNT('Ofertas'[company]),
			    FILTER('Ofertas', NOT ISBLANK('Ofertas'[company]) && 'Ofertas'[company] <> "")
			)
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 06d7ebce-33f6-40f0-8b55-84a1641d33ee

	/// Carreras distintas asociadas a las ofertas.
	measure Carreras = DISTINCTCOUNT('Carreras'[career_name])
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 1c94334d-cd27-4ba0-b1aa-c6c618dd5741

	/// Habilidades distintas detectadas.
	measure Habilidades = DISTINCTCOUNT('Habilidades'[skill])
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 364b76cd-8b33-4d42-abab-f6e3a3023558

	/// Promedio de la calidad por oferta.
	measure 'Calidad Promedio' = AVERAGE('Ofertas'[quality_score])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 36efa2b5-8c22-4d27-853f-9efcd3f5d1cc

	/// Ofertas que vencen dentro de 7 días.
	measure 'Por Vencer' = CALCULATE([Total Ofertas], 'Ofertas'[status] = "expiring_soon")
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 7c933500-af36-45f9-8a61-16b3a576c228

	/// Ofertas con fecha límite pasada.
	measure Vencidas = CALCULATE([Total Ofertas], 'Ofertas'[status] = "expired")
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 46a65395-fc53-410d-b5bd-32f3ab299f10

	/// Ofertas vigentes.
	measure Vigentes = CALCULATE([Total Ofertas], 'Ofertas'[status] = "active")
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 71f19de5-b996-46fb-99ae-de669b614f05

	/// Subvención mensual promedio, sin valores atípicos mayores a S/ 12,000.
	measure 'Subvención Promedio' = CALCULATE(AVERAGE('Ofertas'[salary_amount]), 'Ofertas'[salary_amount] <= 12000)
		formatString: "S/ "#,0.00
		displayFolder: KPIs
		lineageTag: d5260aee-58db-4558-9588-25905beb1cbc

	/// Días promedio entre la fecha de corte y el vencimiento.
	measure 'Días Promedio para Vencer' = AVERAGE('Ofertas'[days_to_deadline])
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 8020154d-56cb-4709-9568-2bf40450ddab

	/// Resumen dinámico en español o inglés.
	measure 'Mensaje Ejecutivo' =
			VAR lang = SELECTEDVALUE('Idioma'[Idioma], "ES")
			VAR total = FORMAT([Total Ofertas], "#,##0")
			VAR carreras = FORMAT([Carreras], "#,##0")
			VAR porVencerNum = [Por Vencer]
			VAR porVencer = FORMAT(porVencerNum, "#,##0")
			VAR verboEs = IF(porVencerNum = 1, "vence", "vencen")
			VAR verboEn = IF(porVencerNum = 1, "expires", "expire")
			VAR calidad = FORMAT([Calidad General], "0.0%")
			RETURN
			SWITCH(lang,
			    "ES", "Hay " & total & " ofertas en " & carreras & " carreras; " & porVencer & " " & verboEs & " en 7 días. Calidad general: " & calidad & ".",
			    "EN", "There are " & total & " offers across " & carreras & " careers; " & porVencer & " " & verboEn & " within 7 days. Overall quality: " & calidad & "."
			)
		displayFolder: Idioma
		lineageTag: 8266cbea-128f-41fb-886c-b9871c25c9eb

	/// Fecha de corte con etiqueta bilingüe.
	measure Actualizado =
			VAR lang = SELECTEDVALUE('Idioma'[Idioma], "ES")
			VAR fecha = FORMAT(MAX('Metadatos'[as_of]), "dd/mm/yyyy")
			RETURN SWITCH(lang, "ES", "Actualizado al " & fecha, "EN", "Updated on " & fecha)
		displayFolder: Idioma
		lineageTag: d611deaa-2fe9-4d69-a047-3f5aeaf37b7b

